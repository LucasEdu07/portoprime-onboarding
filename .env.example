# Banco de dados — SQLite por padrão (dev local).
# Para produção persistente (Neon/Postgres), troque o provider no schema.prisma para
# "postgresql" e aponte DATABASE_URL para a connection string do Neon.
DATABASE_URL="file:./dev.db"

# Vercel Blob — opcional. Quando presente, uploads de documentos vão para o Blob com
# URL assinada. Sem o token, a app entra em "modo metadados" (grava só nome/tamanho/hash).
# BLOB_READ_WRITE_TOKEN=""

# WhatsApp do CTA — placeholder até o número real (somente dígitos, com DDI/DDD).
NEXT_PUBLIC_WHATSAPP_NUMBER="5512999999999"

# Área administrativa (/admin/*) e GET /api/leads — protegidas por Basic Auth (middleware.ts).
# SEM estas variáveis, as rotas administrativas respondem 503 (fail closed). Defina antes
# da demo. Fase 2: trocar por login real (fenox-sso/Keycloak).
ADMIN_USER="admin"
ADMIN_PASS="troque-esta-senha"
